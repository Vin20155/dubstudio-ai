# Optional server-side Google Gemini API key.
# Leave blank to enter your own key in the web UI (top-right "Gemini API Key" button).
GEMINI_API_KEY=

# Optional CodeCraft API gateway (OpenAI-compatible).
CODECRAFT_API_KEY=
CODECRAFT_BASE_URL=https://codecraftapi.com/v1

# Optional OpenAI API key.
OPENAI_API_KEY=

# Where the app looks for new versions. Use a GitHub repository (owner/repo)
# or a full https:// URL to an update.json file. Set automatically by release.ps1.
KHMERDUB_UPDATE_SOURCE=
